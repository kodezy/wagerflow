{
  "name": "wagerflow",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun src/main.ts",
    "migrate": "bun src/persistence/migrate.ts up",
    "migrate:down": "bun src/persistence/migrate.ts down",
    "queues": "bun src/messaging/queues.ts",
    "typecheck": "tsc",
    "test": "bun test --timeout 120000",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test --timeout 120000 test/integration",
    "test:concurrency": "bun test --timeout 120000 test/concurrency",
    "test:load": "bun scripts/load.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1165.0",
    "@mikro-orm/core": "7.2.8",
    "@mikro-orm/migrations": "7.2.8",
    "@mikro-orm/postgresql": "7.2.8",
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "decimal.js": "10.6.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/express": "5.0.6",
    "typescript": "6.0.3"
  }
}
